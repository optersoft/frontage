---
// `dist/404.html` — Cloudflare Pages serves it, with a 404 status, for any
// unmatched path (public/_redirects is what makes that a real 404 and not the
// front page with a 200).
import Site from "../layouts/Site.astro";
import NotFound from "@optersoft/astro/NotFound.astro";
---

<Site title="Not here — Frontage" description="No such page on frontage.optersoft.com." noindex={true}>
  <NotFound
    heading="Not here"
    body="This page does not exist on frontage.optersoft.com. The documentation moved to the academy, and the old /examples/ pages became the gallery."
    home={{ href: "/", label: "Home" }}
    other={{ href: "/gallery/", label: "The gallery" }}
  />
</Site>
